# 법제처 오픈API 인증키 (필수)
# 발급: https://www.law.go.kr/DRF/lawService.do
LAW_OC=your-api-key-here

# Korean Legal Chatbot Web App Configuration
# ================================================

# Korean Law MCP Server Configuration
# The URL where your Korean Law MCP server is running
KOREAN_LAW_MCP_URL=http://localhost:3001

# OpenAI Configuration
# Your OpenAI API key for the chat model
OPENAI_API_KEY=sk_test_...

# Optional: Specify the model to use (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: Vercel AI Gateway
# If using Vercel AI Gateway instead of direct OpenAI
# AI_GATEWAY_API_KEY=
